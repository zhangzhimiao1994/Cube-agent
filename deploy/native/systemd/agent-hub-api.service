[Unit]
Description=Agent Hub API
After=network-online.target postgresql.service redis.service

[Service]
Type=simple
User=agent-hub
Group=agent-hub
EnvironmentFile=/etc/agent-hub/secrets.env
Environment=AGENT_HUB_WEB_DIR=/opt/agent-hub/current/web/dist
Environment=PYTHONPATH=/opt/agent-hub/current/src
WorkingDirectory=/opt/agent-hub/current
ExecStart=/bin/sh -c 'exec /opt/agent-hub/current/.venv/bin/python -m uvicorn agent_hub.app:app --host ${AGENT_HUB_API_BIND_HOST:-127.0.0.1} --port ${AGENT_HUB_API_PORT:-8000}'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-hub /run/agent-hub
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=agent-hub.target
