AGENT_HUB_IMAGE=agent-hub:latest
AGENT_HUB_PUBLIC_URL=http://127.0.0.1
AGENT_HUB_SECRET_KEY=replace-with-generated-32-byte-base64url
JWT_SIGNING_KEY=base64url:replace-with-generated-32-byte-base64url
DATABASE_URL=postgresql+asyncpg://agent_hub:${POSTGRES_PASSWORD}@postgres:5432/agent_hub
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=agent_hub
POSTGRES_USER=agent_hub
POSTGRES_PASSWORD=replace-with-generated-password
LITELLM_MASTER_KEY=replace-with-generated-litellm-key
FEISHU_APP_ID=
FEISHU_APP_SECRET=
HTTP_PORT=80
HTTPS_PORT=443
