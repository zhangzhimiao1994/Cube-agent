AGENT_HUB_IMAGE=agent-hub:latest
AGENT_HUB_PUBLIC_URL=http://127.0.0.1
AGENT_HUB_ENVIRONMENT=production
AGENT_HUB_MASTER_KEY=replace-with-generated-32-byte-base64
AGENT_HUB_JWT_SIGNING_KEY=base64url:replace-with-generated-32-byte-base64url
AGENT_HUB_DATABASE_URL=postgresql+asyncpg://agent_hub:replace-with-generated-password@postgres:5432/agent_hub
AGENT_HUB_REDIS_URL=redis://redis:6379/0
AGENT_HUB_LITELLM_HEALTH_URL=http://litellm:4000/health/liveliness
AGENT_HUB_RUNTIME_TIMEOUT_SECONDS=300
AGENT_HUB_RUNTIME_TOKEN_BUDGET=1000000
POSTGRES_DB=agent_hub
POSTGRES_USER=agent_hub
POSTGRES_PASSWORD=replace-with-generated-password
LITELLM_MASTER_KEY=replace-with-generated-litellm-key
AGENT_HUB_SETUP_CODE=replace-with-generated-32-byte-base64url
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
HTTP_PORT=80
HTTPS_PORT=443
