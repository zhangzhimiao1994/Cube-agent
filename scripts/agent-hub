#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMMAND_DIR="$SCRIPT_DIR/commands"

usage() {
  cat <<'EOF'
Usage: scripts/agent-hub <command>

Commands:
  doctor              Diagnose host, dependencies, ports, services, and health.
  status              Show service status.
  logs                Tail service logs.
  backup              Create or verify a backup.
  restore             Restore a verified backup.
  upgrade             Upgrade with backup and readiness rollback.
  prune-releases      Preview or remove old native release directories.
  verify-release      Verify native current release pointer and service state.
  harness-acceptance  Run Codex/DeepSeek harness acceptance smoke and stress checks.
  project-scale-acceptance
                      Run project-scale acceptance fixture planning and execution.
  real-user-four-scale-acceptance
                      Run logged-in small/medium/large/ultra acceptance.
  openclaw-adapter     Start a local OpenClaw Adapter.
  build-skill-runner  Build the isolated Docker Skill runner image.
  package-release     Build a deployable source archive including web/dist.
  version             Print installed version.
EOF
}

command="${1:-}"
if [[ -z "$command" || "$command" == "--help" ]]; then
  usage
  exit 0
fi
shift || true

case "$command" in
  real-user-four-scale-acceptance)
    exec bash "$COMMAND_DIR/real-user-four-scale-acceptance.sh" "$@"
    ;;
  doctor|status|logs|backup|restore|upgrade|prune-releases|verify-release|harness-acceptance|project-scale-acceptance|openclaw-adapter|build-skill-runner|package-release)
    exec "$COMMAND_DIR/$command.sh" "$@"
    ;;
  version)
    cat "${AGENT_HUB_STATE_DIR:-/var/lib/agent-hub}/version" 2>/dev/null || printf '0.1.0\n'
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
